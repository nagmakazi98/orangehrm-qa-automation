<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Individual Test Isolation Suite
  ================================
  Demonstrates that every test method in EmployeeLifecycleTest is independently
  runnable. Each <test> block below represents a self-contained execution unit.

  Architecture guarantees:
    - No dependsOnMethods chaining  - one failure CANNOT skip any other test.
    - @BeforeMethod(alwaysRun=true) - login + session reset before EVERY test.
    - @AfterMethod(alwaysRun=true)  - API cleanup runs even if the test throws.
    - Per-test createdEmpNumber     - no shared mutable state between tests.

  Run a single test:
    mvn clean test -DsuiteXmlFile=testng-individual.xml "-Dtest=EmployeeLifecycleTest#testAddNewEmployee"

  Run all isolated tests in sequence:
    mvn clean test -DsuiteXmlFile=testng-individual.xml
-->
<suite name="Individual Test Isolation Demo" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.orangehrm.listeners.TestListener"/>
        <listener class-name="com.orangehrm.listeners.RetryAnnotationTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- 1. Login -->
    <test name="testLogin (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testLogin"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 2. Add Employee (UI creation + API cross-validation) -->
    <test name="testAddNewEmployee (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testAddNewEmployee"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 3. Search Employee (API precondition, UI search, API cleanup) -->
    <test name="testVerifyEmployeeCreated (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testVerifyEmployeeCreated"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 4. Edit Employee (API precondition, UI update, API verify) -->
    <test name="testEditEmployeeInformation (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testEditEmployeeInformation"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 5. API Validation (API create, typed DTO assertions) -->
    <test name="testValidateEmployeeViaApi (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testValidateEmployeeViaApi"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 6. Delete Employee (API precondition, UI delete, API verify) -->
    <test name="testDeleteEmployee (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testDeleteEmployee"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- 7. Logout + session invalidation -->
    <test name="testLogout (isolated)">
        <classes>
            <class name="com.orangehrm.tests.EmployeeLifecycleTest">
                <methods>
                    <include name="testLogout"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
